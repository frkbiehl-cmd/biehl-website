{
  "name": "biehl-website",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "contact-worker.mjs",
  "send_email": [
    {
      "name": "CONTACT_EMAIL"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "20261030",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
